# =========================================================
# Kitty configuration
# Converted from the WezTerm configuration
# =========================================================


# ---------------------------------------------------------
# Font
# ---------------------------------------------------------

font_family      Hack Nerd Font
bold_font        auto
italic_font      auto
bold_italic_font auto

font_size 13


# ---------------------------------------------------------
# Window appearance
# ---------------------------------------------------------

# Hide the macOS title bar while preserving the window frame
# and resize behavior.
hide_window_decorations titlebar-only

# WezTerm equivalent:
# left   = 12
# right  = 12
# top    = 84
# bottom = 12
#
# Kitty order:
# top right bottom left
window_padding_width 12 12 12 12

# Keep any unavoidable extra cell-space aligned consistently.
placement_strategy top-left

# Slightly transparent background.
background_opacity 0.98

# Do not dynamically change opacity.
dynamic_background_opacity no

# No background blur, matching the original WezTerm config.
background_blur 0

# Hide the mouse immediately while typing.
# A negative value means hide on keyboard input.
mouse_hide_wait -1


# ---------------------------------------------------------
# macOS behavior
# ---------------------------------------------------------

# Use Kitty's traditional fullscreen instead of the native
# macOS Spaces fullscreen transition.
macos_traditional_fullscreen yes

# Extend the terminal into the display safe-area around the notch.
macos_fullscreen_ignore_safe_area_insets yes

# Keep OS windows resizable.
macos_window_resizable yes

# Standard macOS behavior: Kitty remains running after the final
# window is closed.
macos_quit_when_last_window_closed no

# Do not show the active terminal title in the window title bar.
macos_show_window_title_in none

# Use the terminal background for any remaining titlebar area.
# macos_titlebar_color background


# ---------------------------------------------------------
# Initial window size
# ---------------------------------------------------------

# Disable saved window sizing so the dimensions below are used
# when launching a new Kitty instance.
remember_window_size no

# The "c" suffix means terminal cells.
initial_window_width  150c
initial_window_height 50c

# Preserve normal pixel-level window resizing.
resize_in_steps no


# ---------------------------------------------------------
# Tab bar
# ---------------------------------------------------------

# Match WezTerm's bottom tab bar.
tab_bar_edge bottom

# Closest Kitty equivalent to WezTerm's fancy tab bar.
tab_bar_style powerline
tab_powerline_style round

# Hide the tab bar when only one tab exists.
tab_bar_min_tabs 2

# Keep the tab bar aligned from the left.
tab_bar_align left

# Do not permanently show a new-tab button.
tab_bar_show_new_tab_button no

# Use the terminal background behind the tab bar.
# tab_bar_background none
# tab_bar_margin_color none

# No extra tab-bar margins.
tab_bar_margin_width 0
tab_bar_margin_height 0 0


# ---------------------------------------------------------
# Terminal behavior
# ---------------------------------------------------------

# Use Kitty's shell integration where supported.
shell_integration enabled

# Preserve full terminal color support.
term xterm-kitty

# Do not confirm when closing an ordinary window.
confirm_os_window_close 0

# Keep scrollback reasonably large.
scrollback_lines 10000

# Allow remote applications to set the window title.
allow_remote_control no


# ---------------------------------------------------------
# Text rendering
# ---------------------------------------------------------

# Leave programming ligatures enabled everywhere.
disable_ligatures never

# Avoid artificial font thickening.
macos_thicken_font 0

# Let Kitty choose the normal text-composition strategy.
text_composition_strategy platform


# ---------------------------------------------------------
# Cursor
# ---------------------------------------------------------

cursor_shape block
cursor_blink_interval -1
cursor_stop_blinking_after 15


# ---------------------------------------------------------
# Bell
# ---------------------------------------------------------

enable_audio_bell no
visual_bell_duration 0
window_alert_on_bell no
bell_on_tab no


# ---------------------------------------------------------
# URLs
# ---------------------------------------------------------

url_style curly
open_url_with default
detect_urls yes


# ---------------------------------------------------------
# Clipboard
# ---------------------------------------------------------

copy_on_select no
strip_trailing_spaces smart


# ---------------------------------------------------------
# Kitty keyboard shortcuts
# ---------------------------------------------------------

# Since tmux handles most panes and sessions, disable several
# Kitty defaults that may conflict with terminal applications.

map ctrl+shift+enter no_op
map ctrl+shift+t     no_op
map ctrl+shift+w     no_op
map ctrl+shift+]     no_op
map ctrl+shift+[     no_op
map ctrl+shift+right no_op
map ctrl+shift+left  no_op

# Keep convenient macOS-native actions.
map cmd+c copy_to_clipboard
map cmd+v paste_from_clipboard
map cmd+n new_os_window
map cmd+w close_os_window
map cmd+q quit
map cmd+plus  change_font_size all +1.0
map cmd+minus change_font_size all -1.0
map cmd+0     change_font_size all 0


# ---------------------------------------------------------
# Theme
# ---------------------------------------------------------

# BEGIN_KITTY_THEME
# Gruvbox Dark Soft
include current-theme.conf
# END_KITTY_THEME
